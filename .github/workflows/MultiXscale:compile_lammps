name: MultiXscale-compile_lammps
run-name: Check new plugins of LAMMPS
on:
  push:
    paths:
      - '.github/**'
      - 'src/OBMD/**'
      - 'examples/OBMD/**'
jobs:
  Get-changed-files:
    name: Get changed files
    runs-on: ubuntu-latest
    steps:
      - uses: eessi/github-action-eessi@v3
      - name: set up EasyBuild
        run: |
          module load EasyBuild/4.9.4
          export EASYBUILD_SOURCEPATH=.github/easybuild/sources
          export EASYBUILD_INSTALLPATH=.github/easybuild
          export EASYBUILD_TRACE=1
          eb --show-config
